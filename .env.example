# Port the HTTP server listens on.
PORT=3000

# Optional: path to a different calendar config file.
# ONECAL_CONFIG=./config/calendars.json

# Overrides the feed name shown in calendar apps.
# ONECAL_FEED_NAME=Bay Area Tech

# Default IANA timezone for floating times and all-day handling.
# ONECAL_TIMEZONE=America/Los_Angeles
